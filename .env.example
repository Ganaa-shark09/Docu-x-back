# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=docux
POSTGRES_USER=docux
POSTGRES_PASSWORD=docux_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# LLM
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Security
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# LLM Provider Defaults
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-10-21

# Ollama Local LLM
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.2:1b

# External AI web search
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_TIMEOUT_SECONDS=10

# External AI image understanding
OLLAMA_VISION_ENABLED=True
OLLAMA_VISION_MODEL=llava:latest
OLLAMA_VISION_TIMEOUT_SECONDS=120

# External AI retrieval limits
EXTERNAL_AI_DOCUMENT_CONTEXT_CHAR_LIMIT=18000
EXTERNAL_AI_DOCUMENT_CHUNK_CHAR_LIMIT=6000
EXTERNAL_AI_DOCUMENT_TOP_K=12

# JWT lifetime
JWT_ACCESS_TOKEN_MINUTES=480
JWT_REFRESH_TOKEN_DAYS=30
