DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-dev-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,django

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

DEFAULT_LLM_PROVIDER=ollama
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

OPENAI_DEFAULT_MODEL=gpt-4.1-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-10-21

# Ollama local text model.
# qwen3:14b is not practical on this CPU-only Docker runtime (~0.05-0.13 tok/s).
# qwen3:8b keeps the Qwen3 behavior while reducing model memory substantially.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=qwen3:8b
OLLAMA_FAST_TEXT_MODEL=qwen3:4b-instruct
OLLAMA_QUALITY_TEXT_MODEL=qwen3:8b
OLLAMA_DIRECT_FAST_MODEL=qwen3:4b-instruct
OLLAMA_DIRECT_QUALITY_MODEL=qwen3:8b
OLLAMA_CODING_MODEL=qwen2.5-coder:7b
OLLAMA_DOCUMENT_REASONING_MODEL=qwen3:8b
OLLAMA_WEB_ANSWER_MODEL=qwen3:8b
OLLAMA_DOCUMENT_SUMMARY_MAP_MODEL=qwen3:4b-instruct
OLLAMA_DOCUMENT_SUMMARY_FINAL_MODEL=qwen3:8b
OLLAMA_REQUEST_KEEP_ALIVE=60m

# External AI semantic orchestrator.
# This is the live routing path for External AI and also produces the final
# response for direct/general conversation, avoiding a second LLM call.
OLLAMA_ORCHESTRATOR_MODEL=qwen3:4b-instruct
OLLAMA_ORCHESTRATOR_NUM_CTX=4096
OLLAMA_ORCHESTRATOR_TIMEOUT_SECONDS=120
OLLAMA_ORCHESTRATOR_MAX_TOKENS=220
OLLAMA_ORCHESTRATOR_QUALITY_FALLBACK=True

# External AI answer generation.
OLLAMA_ANSWER_TIMEOUT_SECONDS=240
OLLAMA_GENERAL_TIMEOUT_SECONDS=300
OLLAMA_FAST_ANSWER_TIMEOUT_SECONDS=120
OLLAMA_FAST_ANSWER_MAX_TOKENS=320
OLLAMA_FAST_ANSWER_NUM_CTX=4096
OLLAMA_QUALITY_ANSWER_TIMEOUT_SECONDS=420
OLLAMA_QUALITY_ANSWER_MAX_TOKENS=1400
OLLAMA_QUALITY_ANSWER_NUM_CTX=4096
OLLAMA_QUALITY_ANSWER_TEMPERATURE=0.1
OLLAMA_QUALITY_THINKING_MODE=true
OLLAMA_QUALITY_REASONING_TIMEOUT_SECONDS=600
OLLAMA_QUALITY_REASONING_MAX_TOKENS=1800
OLLAMA_CODING_ANSWER_TIMEOUT_SECONDS=420
OLLAMA_CODING_ANSWER_MAX_TOKENS=1400
OLLAMA_CODING_ANSWER_NUM_CTX=4096
OLLAMA_CODING_ANSWER_TEMPERATURE=0.1

# Document summarization on CPU: keep a bounded output budget but allow enough
# wall time for full-document synthesis to finish cleanly.
OLLAMA_DOCUMENT_SUMMARY_TIMEOUT_SECONDS=360
OLLAMA_DOCUMENT_SUMMARY_MAX_TOKENS=900
OLLAMA_DOCUMENT_SUMMARY_MAP_TIMEOUT_SECONDS=180
OLLAMA_DOCUMENT_SUMMARY_MAP_MAX_TOKENS=240
OLLAMA_DOCUMENT_SUMMARY_NUM_CTX=4096
OLLAMA_DOCUMENT_SUMMARY_MAP_NUM_CTX=4096
OLLAMA_DOCUMENT_SUMMARY_RETRY_MAX_TOKENS=900
OLLAMA_DOCUMENT_QA_TIMEOUT_SECONDS=240
OLLAMA_DOCUMENT_QA_MAX_TOKENS=800
OLLAMA_DOCUMENT_ANALYSIS_TIMEOUT_SECONDS=300
OLLAMA_DOCUMENT_ANALYSIS_MAX_TOKENS=1000

# Standalone intent classifier compatibility settings.
# The live External AI path currently uses the semantic orchestrator above.
OLLAMA_INTENT_MODEL=qwen3:4b-instruct
OLLAMA_INTENT_TIMEOUT_SECONDS=90
OLLAMA_INTENT_MAX_TOKENS=120

# Shared Ollama generation settings.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
OLLAMA_DEFAULT_MAX_TOKENS=900
OLLAMA_GENERAL_NUM_CTX=4096

# External AI web search
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_TIMEOUT_SECONDS=10

# External AI image understanding
OLLAMA_VISION_ENABLED=True
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_VISION_FAST_MODEL=qwen3-vl:4b-instruct
OLLAMA_VISION_QUALITY_MODEL=qwen3-vl:8b
OLLAMA_VISION_FAST_OCR_MIN_CHARS=250
OLLAMA_VISION_FAST_TIMEOUT_SECONDS=120
OLLAMA_VISION_FAST_MAX_TOKENS=300
OLLAMA_VISION_NUM_CTX=4096
OLLAMA_VISION_TIMEOUT_SECONDS=180
OLLAMA_VISION_MAX_TOKENS=450
OLLAMA_VISION_KEEP_ALIVE=10m

# External AI retrieval limits
EXTERNAL_AI_DOCUMENT_CONTEXT_CHAR_LIMIT=18000
EXTERNAL_AI_DOCUMENT_CHUNK_CHAR_LIMIT=6000
EXTERNAL_AI_DOCUMENT_TOP_K=12
EXTERNAL_AI_SUMMARY_SINGLE_PASS_CHAR_LIMIT=7000
EXTERNAL_AI_SUMMARY_SINGLE_PASS_SOURCE_TOKEN_LIMIT=1400
EXTERNAL_AI_SUMMARY_CHUNK_CHAR_LIMIT=4200
EXTERNAL_AI_SUMMARY_CHUNK_OVERLAP=150
EXTERNAL_AI_SUMMARY_PROMPT_OVERHEAD_TOKENS=650
EXTERNAL_AI_SUMMARY_CONTEXT_SAFETY_RATIO=0.90
EXTERNAL_AI_SUMMARY_RETRY_MAX_DEPTH=2
EXTERNAL_AI_SUMMARY_RETRY_MIN_CHARS=2200

# JWT local development lifetime
JWT_ACCESS_TOKEN_MINUTES=480
JWT_REFRESH_TOKEN_DAYS=30

DOCUX_AI_LOG_LEVEL=INFO

# Realtime document processing over Django Channels.
# Redis DB 2 is intentionally separate from Celery broker (0) and result backend (1).
CHANNEL_LAYER_REDIS_URL=redis://redis:6379/2
CHANNEL_LAYER_CAPACITY=1000
CHANNEL_LAYER_EXPIRY_SECONDS=60
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
WEBSOCKET_TICKET_MAX_AGE_SECONDS=60
WEBSOCKET_MAX_DOCUMENT_SUBSCRIPTIONS=200
DOCUMENT_PROCESSING_QUEUE=document_processing
